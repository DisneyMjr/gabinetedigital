<?php
// 1. Configurações de Erro (Ative para depurar, desative em produção)
ini_set('display_errors', 1);
ini_set('display_startup_errors', 1);
error_reporting(E_ALL);

require_once 'tracker.php'; 

// 2. Importação de dependências
if (file_exists('config.php')) {
    require_once 'config.php';
} else {
    die("Erro: Arquivo config.php não encontrado.");
}

// IMPORTANTE: Aqui carregamos os arquivos de pagamento para evitar o Erro 500
if (file_exists('gateway.php')) require_once 'gateway.php';
// Se você usa um arquivo gateway.php que gerencia Vindi/Efí, inclua-o aqui:
// if (file_exists('gateway.php')) require_once 'gateway.php';

// --- BUSCA BANNERS HERO ---
$hero_banners = [];
try {
    $stmt = $pdo->query("SELECT caminho_imagem, titulo, frase_apoio FROM login_banners WHERE tipo = 'hero' AND ativo = 1 ORDER BY id DESC");
    $hero_banners = $stmt->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) { $hero_banners = []; }
$usar_carrossel = (count($hero_banners) > 0);

// --- PROCESSAMENTO DO CADASTRO ---
$msg_cadastro = "";
$erro_cadastro = ""; 
$link_direto = "";
$is_pago = false;
$preco_plano = 0;
$pix_data = null;
$txid = "";

if ($_SERVER['REQUEST_METHOD'] == 'POST' && isset($_POST['acao'])) {
    if (!isset($pdo)) die("Erro de conexão com o banco de dados.");
    
    $nome = trim($_POST['nome']);
    $email = trim($_POST['email']);
    $whatsapp = trim($_POST['whatsapp']);
    $senha = trim($_POST['senha']);
    $slug_base = strtolower(preg_replace('/[^a-z0-9]/', '', $_POST['slug']));
    $tipo_cadastro = $_POST['acao']; 
    $slug_plano = $_POST['plano_escolhido'] ?? 'teste-gratis';

    try {
        $pdo->setAttribute(PDO::ATTR_ERRMODE, PDO::ERRMODE_EXCEPTION);

        if (strlen($slug_base) < 3) throw new Exception("O endereço do site deve ter pelo menos 3 letras.");
        
        // Verifica se slug já existe
        $stmt_check = $pdo->prepare("SELECT count(*) FROM tenants WHERE slug = ?");
        $stmt_check->execute([$slug_base]);
        if($stmt_check->fetchColumn() > 0) throw new Exception("Este endereço de site já está em uso.");
        
        // Verifica se e-mail já existe
        $stmt_email = $pdo->prepare("SELECT count(*) FROM usuarios WHERE email = ?");
        $stmt_email->execute([$email]);
        if($stmt_email->fetchColumn() > 0) throw new Exception("Este e-mail já está cadastrado.");

        $pdo->beginTransaction();
        
        if ($tipo_cadastro == 'criar_teste') {
            $status = 'ativo'; 
            $ativo = 1; 
            $vencimento = date('Y-m-d H:i:s', strtotime('+7 days'));
        } else {
            $status = 'pendente_pagamento'; 
            $ativo = 0; 
            $vencimento = date('Y-m-d H:i:s', strtotime('+30 days'));
            $is_pago = true;

            $stmt_plano = $pdo->prepare("SELECT preco FROM planos WHERE slug = ?");
            $stmt_plano->execute([$slug_plano]);
            $preco_plano = (float) $stmt_plano->fetchColumn();
        }

        // 1. Cria o Tenant
        $stmt = $pdo->prepare("INSERT INTO tenants (nome, slug, email_contato, plano, ativo, data_vencimento, status) VALUES (?, ?, ?, ?, ?, ?, ?)");
        $stmt->execute([$nome, $slug_base, $email, $slug_plano, $ativo, $vencimento, $status]);
        $tenant_id = $pdo->lastInsertId();

        // 2. Configurações Iniciais
        $pdo->prepare("INSERT INTO configuracoes (tenant_id, nome_vereador, whatsapp_oficial, cor_primaria) VALUES (?, ?, ?, '#6366f1')")
            ->execute([$tenant_id, $nome, $whatsapp]);
        
        // 3. Usuário Admin
        $senha_hash = password_hash($senha, PASSWORD_DEFAULT);
        $permissoes = json_encode(['noticias', 'agenda', 'ouvidoria', 'transparencia', 'config', 'eleitores', 'landing', 'relatorios', 'enquetes', 'equipe', 'auditoria']);
        $pdo->prepare("INSERT INTO usuarios (tenant_id, nome, email, senha, permissoes) VALUES (?, 'Admin', ?, ?, ?)")
            ->execute([$tenant_id, $email, $senha_hash, $permissoes]);

        // GERAÇÃO DO PIX (Ajustado para Vindi)
        if ($is_pago && $preco_plano > 0) {
            $descricao_venda = "Assinatura " . ucfirst($slug_plano) . " - " . $nome;
            
            // Verifique se a função existe para evitar Erro 500
            if (function_exists('gerarCobrancaSaaS')) {
                $pix_data = gerarCobrancaSaaS($nome, $email, $preco_plano, $descricao_venda, $slug_base);
            } else {
                // Se não houver roteador, chamamos a Vindi diretamente como fallback
                // Supondo que você tenha a função chamarAPI_Vindi pronta
                throw new Exception("Erro interno: Gateway de pagamento não configurado.");
            }
            
            if (isset($pix_data['erro'])) {
                throw new Exception("Erro no Pix: " . $pix_data['erro']);
            }

            $txid = $pix_data['fatura_id'] ?? '';
            $pdo->prepare("UPDATE tenants SET txid_pagamento = ? WHERE id = ?")->execute([$txid, $tenant_id]);
        }

        $pdo->commit();
        
        // Definição de links (Ajustado para evitar loops de subdomínio em alguns servidores)
        $protocolo = (isset($_SERVER['HTTPS']) && $_SERVER['HTTPS'] === 'on') ? "https://" : "http://";
        $dominio = str_replace('www.', '', $_SERVER['HTTP_HOST']);
       // Isso evita que o navegador tente entrar no subdomínio antes da hora
        $link_painel = $protocolo . $dominio . "/login.php?cliente=" . $slug_base;
        $link_direto = $link_painel;
        
        $msg_cadastro = "sucesso";
        
    } catch (Exception $e) { 
        if (isset($pdo) && $pdo->inTransaction()) $pdo->rollBack(); 
        $erro_cadastro = $e->getMessage(); 
    }
}

// BUSCA PLANOS PARA A TABELA
try {
    $stmt_planos = $pdo->query("SELECT * FROM planos WHERE ativo = 1 ORDER BY preco ASC");
    $planos_db = $stmt_planos->fetchAll(PDO::FETCH_ASSOC);
} catch (Exception $e) { $planos_db = []; }
?>
